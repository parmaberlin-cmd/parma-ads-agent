{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parma-agent-state-1.2",
  "type": "object",
  "required": ["schema_version", "genome_version", "global", "agents", "tasks", "approvals", "experiments"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "genome_version": {"type": "string"},
    "global": {
      "type": "object",
      "required": ["project_status", "current_p0", "last_meaningful_capability_gain"],
      "properties": {
        "project_status": {"type": "string"},
        "current_p0": {"type": ["string", "null"]},
        "last_meaningful_capability_gain": {"type": ["string", "null"]},
        "infrastructure_progress": {"type": "number", "minimum": 0, "maximum": 100},
        "autonomy_progress": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": true
    },
    "agents": {
      "type": "object",
      "properties": {
        "control_tower": {"type": "object"},
        "google": {"type": "object"},
        "meta": {"type": "object"},
        "engineering": {"type": "object"},
        "intelligence": {"type": "object"},
        "automation": {"type": "object"}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "priority", "status", "evidence", "expected_result"],
        "properties": {
          "id": {"type": "string"},
          "owner": {"enum": ["control_tower", "google", "meta", "engineering", "intelligence", "automation"]},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "status": {"enum": ["READY", "LEASED", "BLOCKED", "DONE", "CANCELLED"]},
          "evidence": {"type": "string"},
          "expected_result": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "lease_owner": {"type": ["string", "null"]},
          "lease_until": {"type": ["string", "null"], "format": "date-time"},
          "idempotency_key": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "approvals": {"type": "array", "items": {"type": "object"}},
    "experiments": {"type": "array", "items": {"type": "object"}},
    "history_ref": {"type": ["string", "null"]},
    "mutation_graveyard_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}